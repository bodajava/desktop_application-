<?xml version="1.0" encoding="UTF-8"?>

<?import com.examhalls.ui.BusyOverlay?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.examhalls.controller.ExamOperationsController">
    <VBox styleClass="content">

        <!-- ===== Exam header: selector, details, actions ===== -->
        <VBox styleClass="card">
            <HBox styleClass="toolbar" alignment="BOTTOM_LEFT">
                <VBox styleClass="form-field" HBox.hgrow="ALWAYS">
                    <Label text="%ops.exam" styleClass="field-label"/>
                    <ComboBox fx:id="examCombo" maxWidth="Infinity" promptText="%ops.selectExam"/>
                </VBox>
                <Button fx:id="seatButton" text="%action.generateSeating" onAction="#onGenerateSeating"
                        styleClass="button-secondary, toolbar-button" minWidth="-Infinity"/>
                <Button fx:id="allocateButton" text="%action.allocateProctors" onAction="#onAllocate"
                        styleClass="button-primary, toolbar-button" minWidth="-Infinity"/>
                <Button fx:id="cancelButton" text="%action.cancelAllocation" onAction="#onCancelAllocation"
                        styleClass="button-danger-outline, toolbar-button" minWidth="-Infinity"/>
            </HBox>

            <HBox styleClass="metric-row">
                <VBox styleClass="metric">
                    <Label text="%ops.metric.slot" styleClass="metric-label"/>
                    <Label fx:id="slotValue" text="—" styleClass="metric-value"/>
                </VBox>
                <VBox styleClass="metric">
                    <Label text="%ops.metric.seated" styleClass="metric-label"/>
                    <Label fx:id="seatedValue" text="—" styleClass="metric-value"/>
                </VBox>
                <VBox styleClass="metric">
                    <Label text="%ops.metric.rooms" styleClass="metric-label"/>
                    <Label fx:id="roomsValue" text="—" styleClass="metric-value"/>
                </VBox>
                <VBox styleClass="metric">
                    <Label text="%ops.metric.staff" styleClass="metric-label"/>
                    <Label fx:id="staffValue" text="—" styleClass="metric-value"/>
                </VBox>
                <VBox styleClass="metric">
                    <Label text="%ops.metric.special" styleClass="metric-label"/>
                    <Label fx:id="specialValue" text="—" styleClass="metric-value"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="stageBadge" styleClass="badge"/>
            </HBox>
        </VBox>

        <!-- ===== Matrix (top) + room details (bottom) ===== -->
        <SplitPane fx:id="split" orientation="VERTICAL" dividerPositions="0.45" VBox.vgrow="ALWAYS" styleClass="plain-split">
            <VBox styleClass="card, table-card">
                <Label text="%ops.matrix" styleClass="card-title"/>
                <TableView fx:id="matrixTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="mRoomCol" text="%ops.col.room" prefWidth="90"/>
                        <TableColumn fx:id="mBuildingCol" text="%ops.col.building" prefWidth="170"/>
                        <TableColumn fx:id="mOccupancyCol" text="%ops.col.occupancy" prefWidth="170"/>
                        <TableColumn fx:id="mSpecialCol" text="%ops.col.special" prefWidth="90"/>
                        <TableColumn fx:id="mHeadCol" text="%ops.col.head" prefWidth="190"/>
                        <TableColumn fx:id="mProctorsCol" text="%ops.col.proctors" prefWidth="320"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                    <placeholder><Label fx:id="matrixPlaceholder" text="%ops.matrix.empty" styleClass="muted"/></placeholder>
                </TableView>
            </VBox>

            <VBox styleClass="card, table-card">
                <HBox alignment="CENTER_LEFT" styleClass="card-header">
                    <Label fx:id="roomTitle" text="%ops.room.none" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="substituteButton" text="%action.substitute" onAction="#onSubstitute"
                            styleClass="button-danger" minWidth="-Infinity"/>
                </HBox>
                <TabPane fx:id="detailTabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <Tab text="%ops.tab.staff">
                        <TableView fx:id="staffTable">
                            <columns>
                                <TableColumn fx:id="sRoleCol" text="%ops.col.role" prefWidth="170"/>
                                <TableColumn fx:id="sTeacherCol" text="%ops.col.teacher" prefWidth="240"/>
                                <TableColumn fx:id="sCodeCol" text="%ops.col.code" prefWidth="120"/>
                                <TableColumn fx:id="sExamCol" text="%ops.col.attachedExam" prefWidth="160"/>
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                            <placeholder><Label text="%ops.staff.empty" styleClass="muted"/></placeholder>
                        </TableView>
                    </Tab>
                    <Tab text="%ops.tab.seating">
                        <TableView fx:id="seatTable">
                            <columns>
                                <TableColumn fx:id="seatNoCol" text="%ops.col.seat" prefWidth="80"/>
                                <TableColumn fx:id="seatCodeCol" text="%ops.col.studentCode" prefWidth="130"/>
                                <TableColumn fx:id="seatNameCol" text="%ops.col.student" prefWidth="260"/>
                                <TableColumn fx:id="seatNeedsCol" text="%ops.col.needs" prefWidth="130"/>
                                <TableColumn fx:id="seatAttendanceCol" text="%ops.col.attendance" prefWidth="140"/>
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                        </TableView>
                    </Tab>
                </TabPane>
            </VBox>
        </SplitPane>
    </VBox>
    <BusyOverlay fx:id="busy"/>
</StackPane>
