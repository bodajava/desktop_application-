<?xml version="1.0" encoding="UTF-8"?>

<?import com.examhalls.ui.BusyOverlay?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.examhalls.controller.UsersController">
    <VBox styleClass="content">
        <HBox styleClass="toolbar" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="%users.search" prefWidth="280"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="deleteButton" text="%users.delete" onAction="#onDelete" styleClass="button-danger-outline, toolbar-button" minWidth="-Infinity"/>
            <Button fx:id="resetButton" text="%users.resetPassword" onAction="#onResetPassword" styleClass="button-secondary, toolbar-button" minWidth="-Infinity"/>
            <Button fx:id="editButton" text="%users.edit" onAction="#onEdit" styleClass="button-secondary, toolbar-button" minWidth="-Infinity"/>
            <Button text="%users.new" onAction="#onNew" styleClass="button-primary, toolbar-button" minWidth="-Infinity"/>
        </HBox>
        <VBox styleClass="card, table-card" VBox.vgrow="ALWAYS">
            <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="usernameCol" text="%login.username" prefWidth="150"/>
                    <TableColumn fx:id="nameCol" text="%users.col.fullName" prefWidth="220"/>
                    <TableColumn fx:id="roleCol" text="%ops.col.role" prefWidth="170"/>
                    <TableColumn fx:id="teacherCol" text="%users.col.teacher" prefWidth="240"/>
                    <TableColumn fx:id="createdCol" text="%users.col.created" prefWidth="150"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                <placeholder><Label text="%users.empty" styleClass="muted"/></placeholder>
            </TableView>
            <Label fx:id="summaryLabel" styleClass="muted"/>
        </VBox>
    </VBox>
    <BusyOverlay fx:id="busy"/>
</StackPane>
