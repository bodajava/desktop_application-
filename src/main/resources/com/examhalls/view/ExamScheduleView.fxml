<?xml version="1.0" encoding="UTF-8"?>

<?import com.examhalls.ui.BusyOverlay?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.examhalls.controller.ExamScheduleController">
    <VBox styleClass="content">
        <!-- Toolbar: filter on the left, actions on the right -->
        <HBox styleClass="toolbar" alignment="CENTER_LEFT">
            <VBox styleClass="form-field">
                <Label text="%schedule.from" styleClass="field-label"/>
                <DatePicker fx:id="fromDate" prefWidth="160"/>
            </VBox>
            <VBox styleClass="form-field">
                <Label text="%schedule.to" styleClass="field-label"/>
                <DatePicker fx:id="toDate" prefWidth="160"/>
            </VBox>
            <Button text="%common.refresh" onAction="#onRefresh" styleClass="button-secondary, toolbar-button" minWidth="-Infinity"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="deleteExamButton" text="%users.delete" onAction="#onDeleteExam"
                    styleClass="button-danger-outline, toolbar-button" minWidth="-Infinity"/>
            <Button fx:id="editExamButton" text="%users.edit" onAction="#onEditExam"
                    styleClass="button-secondary, toolbar-button" minWidth="-Infinity"/>
            <Button fx:id="newExamButton" text="%master.exam.new" onAction="#onNewExam"
                    styleClass="button-primary, toolbar-button" minWidth="-Infinity"/>
        </HBox>

        <VBox styleClass="card, table-card" VBox.vgrow="ALWAYS">
            <HBox styleClass="card-header" alignment="CENTER_LEFT">
                <Label fx:id="selectedLabel" text="%master.exam.selectHint" styleClass="muted"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="seatButton" text="%action.generateSeating" onAction="#onGenerateSeating"
                        styleClass="button-secondary" minWidth="-Infinity"/>
                <Button fx:id="allocateButton" text="%action.allocateProctors" onAction="#onAllocate"
                        styleClass="button-secondary" minWidth="-Infinity"/>
                <Button fx:id="openButton" text="%schedule.open" onAction="#onOpen"
                        styleClass="button-primary" minWidth="-Infinity"/>
            </HBox>
            <TableView fx:id="examTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="dateCol" text="%schedule.col.date" prefWidth="130" minWidth="130"/>
                    <TableColumn fx:id="periodCol" text="%schedule.col.period" prefWidth="185" minWidth="185"/>
                    <TableColumn fx:id="courseCol" text="%schedule.col.course" prefWidth="215"/>
                    <TableColumn fx:id="gradeCol" text="%schedule.col.stage" prefWidth="80" minWidth="80"/>
                    <TableColumn fx:id="seatedCol" text="%schedule.col.seated" prefWidth="70" minWidth="70"/>
                    <TableColumn fx:id="proctorsCol" text="%schedule.col.proctors" prefWidth="75" minWidth="75"/>
                    <TableColumn fx:id="statusCol" text="%schedule.col.status" prefWidth="125" minWidth="125"/>
                    <TableColumn fx:id="notesCol" text="%schedule.col.notes" prefWidth="110"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                <placeholder><Label text="%schedule.empty" styleClass="muted"/></placeholder>
            </TableView>
            <Label fx:id="summaryLabel" styleClass="muted"/>
        </VBox>
    </VBox>
    <BusyOverlay fx:id="busy"/>
</StackPane>
