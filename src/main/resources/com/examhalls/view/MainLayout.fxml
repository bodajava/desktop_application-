<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.examhalls.controller.ShellController"
            styleClass="app-root">

    <!-- ============================ SIDEBAR ============================ -->
    <left>
        <VBox styleClass="sidebar" prefWidth="248" minWidth="248">
            <VBox styleClass="brand">
                <Label text="ExamHalls" styleClass="brand-title"/>
                <Label text="%app.subtitle" styleClass="brand-subtitle" wrapText="true"/>
            </VBox>

            <ScrollPane fitToWidth="true" styleClass="nav-scroll" VBox.vgrow="ALWAYS" hbarPolicy="NEVER">
                <VBox fx:id="navBox" styleClass="nav-box"/>
            </ScrollPane>

            <VBox styleClass="sidebar-footer">
                <Label fx:id="userNameLabel" styleClass="sidebar-user"/>
                <Label fx:id="userRoleLabel" styleClass="role-chip"/>
                <Button text="%nav.signOut" onAction="#onSignOut" styleClass="button-sidebar" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>

    <!-- ============================ CONTENT ============================ -->
    <center>
        <BorderPane>
            <top>
                <HBox styleClass="topbar" alignment="CENTER_LEFT">
                    <VBox>
                        <Label fx:id="pageTitle" styleClass="page-title"/>
                        <Label fx:id="pageSubtitle" styleClass="muted"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="toastLabel" styleClass="toast" visible="false"/>
                </HBox>
            </top>
            <center>
                <StackPane fx:id="contentArea" styleClass="content-area"/>
            </center>
        </BorderPane>
    </center>

    <!-- ============================ STATUS BAR ============================ -->
    <bottom>
        <HBox styleClass="statusbar" alignment="CENTER_LEFT">
            <Label fx:id="dbStatusDot" text="●" styleClass="status-dot, status-idle"/>
            <Label fx:id="dbStatusLabel" styleClass="status-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="v1.0.0" styleClass="status-text"/>
        </HBox>
    </bottom>
</BorderPane>
